{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MinutesWise",
  "mainBinaryName": "minuteswise",
  "identifier": "com.minuteswise.desktop",
  "bundle": {
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.icns",
      "icons/stable/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/AppIcon.icns": "resources/stable/AppIcon.icns"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["minuteswise"] }
    }
  }
}
